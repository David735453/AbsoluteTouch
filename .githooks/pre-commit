#!/bin/sh
# Staged-file checks for local commits. CI runs the full matrix.
#
# Install with `make hooks` (or any of `make setup`, `make check`, `make test`,
# `make lint`). This hook never rewrites files: it reports what is wrong and the
# make target that fixes it.

set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

failed=0

ok() { printf 'ok    %s\n' "$*"; }
skip() { printf 'skip  %s\n' "$*"; }
fail() { printf 'fail  %s\n' "$*"; failed=1; }
detail() { printf '%s\n' "$*" | sed 's/^/      /'; }

changed() { printf '%s\n' "$staged" | grep -qE "$1"; }

check_rust() {
    changed '^desktop/.*\.rs$|^desktop/Cargo\.(toml|lock)$' || return 0
    if out=$(cd desktop && cargo fmt --all -- --check 2>&1); then
        ok "rustfmt"
    else
        fail "rustfmt (run: make fmt)"
        detail "$out" | head -20
    fi
    if out=$(cd desktop && cargo clippy --all-targets -- -D warnings 2>&1); then
        ok "cargo clippy"
    else
        fail "cargo clippy (run: make lint)"
        detail "$out" | head -20
    fi
    if out=$(cd desktop && cargo test --all-targets 2>&1); then
        ok "cargo test"
    else
        fail "cargo test (run: make test-rust)"
        detail "$out" | tail -30
    fi
}

check_swift_format() {
    changed '^ios/.*\.swift$' || return 0
    if ! command -v swift >/dev/null 2>&1; then
        skip "swift format (no swift on PATH)"
        return 0
    fi
    if out=$(swift format lint --strict --recursive ios/AbsoluteTouchCore ios/App 2>&1); then
        ok "swift format"
    else
        fail "swift format (run: make fmt-swift)"
        detail "$out" | head -20
    fi
}

check_swift_tests() {
    changed '^ios/.*\.swift$|^ios/AbsoluteTouchCore/Package\.swift$' || return 0
    if ! command -v swift >/dev/null 2>&1; then
        skip "swift test (no swift on PATH)"
        return 0
    fi
    # Files behind `#if canImport(Network)`, such as UDPTransport, only compile
    # on Apple platforms; the macOS CI job is the first real compiler pass.
    if out=$(swift test --package-path ios/AbsoluteTouchCore 2>&1); then
        ok "swift test"
    else
        fail "swift test (run: make test-swift)"
        detail "$out" | tail -30
    fi
}

check_swiftlint() {
    changed '^ios/.*\.swift$' || return 0
    if ! command -v swiftlint >/dev/null 2>&1; then
        skip "swiftlint (not installed)"
        return 0
    fi
    if ! swiftlint version >/dev/null 2>&1; then
        skip "swiftlint (cannot start: check the Swift runtime library path)"
        return 0
    fi
    if out=$(swiftlint lint --quiet --strict 2>&1); then
        ok "swiftlint"
    else
        fail "swiftlint"
        detail "$out" | head -20
    fi
}

check_workflows() {
    changed '^\.github/workflows/.*\.ya?ml$|^\.github/dependabot\.yml$|^ios/project\.yml$' || return 0
    if ! command -v ruby >/dev/null 2>&1; then
        skip "yaml syntax (no ruby on PATH)"
    elif out=$(ruby -ryaml -e 'ARGV.each { |file| YAML.load_file(file) }' \
        .github/workflows/*.yml .github/dependabot.yml ios/project.yml 2>&1); then
        ok "yaml syntax"
    else
        fail "yaml syntax"
        detail "$out"
    fi
    if ! command -v actionlint >/dev/null 2>&1 && ! command -v docker >/dev/null 2>&1; then
        skip "actionlint (not installed)"
    elif command -v actionlint >/dev/null 2>&1; then
        if out=$(actionlint -ignore 'label ".*" is unknown' 2>&1); then
            ok "actionlint"
        else
            fail "actionlint"
            detail "$out" | head -30
        fi
    elif out=$(docker run --rm \
        -v "$PWD:/repo" -w /repo rhysd/actionlint:1.7.12 \
        -ignore 'label ".*" is unknown' -color 2>&1); then
        ok "actionlint"
    else
        fail "actionlint"
        detail "$out" | head -30
    fi
}

check_plists() {
    changed '^ios/App/.*\.plist$|^ios/App/.*\.xcprivacy$' || return 0
    if ! command -v python3 >/dev/null 2>&1; then
        skip "plist syntax (no python3 on PATH)"
        return 0
    fi
    for file in ios/App/Info.plist ios/App/PrivacyInfo.xcprivacy; do
        [ -f "$file" ] || continue
        if out=$(python3 -c 'import plistlib, sys; plistlib.load(open(sys.argv[1], "rb"))' "$file" 2>&1); then
            ok "plist $file"
        else
            fail "plist $file"
            detail "$out"
        fi
    done
}

check_vectors() {
    changed '^protocol/|^tools/gen_vectors\.py$' || return 0
    if out=$(python3 tools/gen_vectors.py --check 2>&1); then
        ok "golden vectors"
    else
        fail "golden vectors (run: make vectors)"
        detail "$out" | head -20
    fi
}

check_ruby() {
    changed '^ios/Gemfile$|^ios/fastlane/Fastfile$' || return 0
    if ! command -v ruby >/dev/null 2>&1; then
        skip "ruby syntax (no ruby on PATH)"
        return 0
    fi
    for file in ios/Gemfile ios/fastlane/Fastfile; do
        [ -f "$file" ] || continue
        if out=$(ruby -c "$file" 2>&1); then
            ok "ruby -c $file"
        else
            fail "ruby -c $file"
            detail "$out"
        fi
    done
}

check_rust
check_swift_format
check_swift_tests
check_swiftlint
check_workflows
check_plists
check_vectors
check_ruby

if [ "$failed" -ne 0 ]; then
    printf '\nCommit blocked: fix the checks above, re-stage, and commit again.\n'
    exit 1
fi

exit 0
