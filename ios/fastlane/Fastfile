# frozen_string_literal: true

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Archive the app and optionally upload it to TestFlight"
  lane :beta do |options|
    upload = options[:upload].to_s == "true"

    key_path = ENV.fetch("ASC_KEY_PATH")
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    build_number = ENV["BUILD_NUMBER"]
    marketing_version = ENV["MARKETING_VERSION"]

    ios_root = File.expand_path("..", __dir__)
    project_path = File.join(ios_root, "AbsoluteTouch.xcodeproj")
    archive_path = File.join(ios_root, "build", "AbsoluteTouch.xcarchive")
    export_path = File.join(ios_root, "build", "export")
    export_options = File.join(ios_root, "ExportOptions.plist")

    auth_flags = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    ].map { |value| Shellwords.escape(value) }.join(" ")

    settings = ["DEVELOPMENT_TEAM=#{team_id}"]
    settings << "CURRENT_PROJECT_VERSION=#{build_number}" unless build_number.to_s.empty?
    settings << "MARKETING_VERSION=#{marketing_version}" unless marketing_version.to_s.empty?

    sh(
      [
        "xcodebuild archive",
        "-project #{Shellwords.escape(project_path)}",
        "-scheme AbsoluteTouch",
        "-configuration Release",
        "-destination 'generic/platform=iOS'",
        "-archivePath #{Shellwords.escape(archive_path)}",
        auth_flags,
        settings.map { |value| Shellwords.escape(value) }.join(" ")
      ].reject(&:empty?).join(" ")
    )

    sh(
      [
        "xcodebuild -exportArchive",
        "-archivePath #{Shellwords.escape(archive_path)}",
        "-exportOptionsPlist #{Shellwords.escape(export_options)}",
        "-exportPath #{Shellwords.escape(export_path)}",
        auth_flags
      ].join(" ")
    )

    if upload
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_path,
        duration: 1200
      )

      upload_to_testflight(
        api_key: api_key,
        ipa: File.join(export_path, "AbsoluteTouch.ipa"),
        skip_waiting_for_build_processing: true
      )
    end
  end
end
