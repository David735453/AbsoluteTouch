# frozen_string_literal: true

require "shellwords"

require_relative "build_number"

# Bundle identifier the app is archived and uploaded as.
APP_IDENTIFIER = "org.dstudios.absolutetouch"

# Build numbers must increase for every upload of one marketing version.
#
# `github.run_number` alone cannot guarantee that: re-running a workflow keeps
# its number, so the second upload is a duplicate that App Store Connect
# rejects, and a workflow file that is deleted and recreated restarts at 1.
# Ask TestFlight what the newest build in this version's train is and take one
# past it, keeping the run number as a floor so an unreadable or empty
# TestFlight cannot hand out a number twice either.
#
# - Parameter `api_key`: App Store Connect API key from `app_store_connect_api_key`.
# - Parameter `version`: Marketing version whose train to inspect; `nil` or an
#   empty string checks every train.
# - Parameter `floor`: Smallest acceptable build number, usually the workflow
#   run number.
# - Returns: The build number to put in `CURRENT_PROJECT_VERSION`.
def next_build_number(api_key:, version:, floor:)
  latest =
    begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        version: version.to_s.empty? ? nil : version,
        initial_build_number: 0
      )
    rescue StandardError => error
      UI.important("Could not read the latest TestFlight build: #{error.message}")
      UI.important("Using the requested build number; the upload is rejected if it was already used.")
      nil
    end

  BuildNumber.resolve(floor: floor, latest: latest)
end

default_platform(:ios)

platform :ios do
  desc "Archive the app and optionally upload it to TestFlight"
  lane :beta do |options|
    upload = options[:upload].to_s == "true"

    key_path = ENV.fetch("ASC_KEY_PATH")
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    marketing_version = ENV["MARKETING_VERSION"]
    requested_build = [ENV["BUILD_NUMBER"].to_i, 1].max

    ios_root = File.expand_path("..", __dir__)
    project_path = File.join(ios_root, "AbsoluteTouch.xcodeproj")
    archive_path = File.join(ios_root, "build", "AbsoluteTouch.xcarchive")
    export_path = File.join(ios_root, "build", "export")
    export_options = File.join(ios_root, "ExportOptions.plist")

    auth_flags = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id
    ].map { |value| Shellwords.escape(value) }.join(" ")

    api_key = nil
    build_number = requested_build
    if upload
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_path,
        duration: 1200
      )
      build_number = next_build_number(
        api_key: api_key,
        version: marketing_version,
        floor: requested_build
      )
    end
    UI.message("Archiving #{marketing_version} build #{build_number}")

    # Let the workflow name its artifacts after the number that was uploaded.
    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
        file.puts("build_number=#{build_number}")
      end
    end

    settings = ["DEVELOPMENT_TEAM=#{team_id}", "CURRENT_PROJECT_VERSION=#{build_number}"]
    settings << "MARKETING_VERSION=#{marketing_version}" unless marketing_version.to_s.empty?

    sh(
      [
        "xcodebuild archive",
        "-project #{Shellwords.escape(project_path)}",
        "-scheme AbsoluteTouch",
        "-configuration Release",
        "-destination 'generic/platform=iOS'",
        "-archivePath #{Shellwords.escape(archive_path)}",
        auth_flags,
        settings.map { |value| Shellwords.escape(value) }.join(" ")
      ].reject(&:empty?).join(" ")
    )

    sh(
      [
        "xcodebuild -exportArchive",
        "-archivePath #{Shellwords.escape(archive_path)}",
        "-exportOptionsPlist #{Shellwords.escape(export_options)}",
        "-exportPath #{Shellwords.escape(export_path)}",
        auth_flags
      ].join(" ")
    )

    if upload
      upload_to_testflight(
        api_key: api_key,
        ipa: File.join(export_path, "AbsoluteTouch.ipa"),
        skip_waiting_for_build_processing: true
      )
    end
  end
end
