root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Swift uses tabs, displayed two columns wide, as enforced by .swift-format.
[*.swift]
indent_style = tab
indent_size = 2

# Rust follows rustfmt, which indents with four spaces.
[*.rs]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

# Markdown follows .prettierrc.json, which indents with tabs two columns wide.
[*.md]
indent_style = tab
indent_size = 2
